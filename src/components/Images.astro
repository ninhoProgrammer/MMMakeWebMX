---
import astroFrontImage from "../images/astro-front.webp";
---

<section class="sticky top-0 z-10 flex h-screen w-screen items-center justify-center p-4 pointer-events-none">
    <h1 class="hero-text pointer-events-none absolute inset-0 flex items-center justify-center px-40 md:px-60 text-center text-2xl font-bold text-(--color-accent) md:text-4xl">
        Al infinito y más posicionamiento de marca.
    </h1>

    <img
        id="heroImage"
        src={astroFrontImage.src}
        alt="Person Image"
        class="z-10 h-full w-full opacity-0 will-change-transform pointer-events-auto transition-all duration-300 ease-out"
    >
</section>

<script>
    const image = document.getElementById('heroImage') as HTMLImageElement | null
    const textElement = document.querySelector<HTMLElement>('.hero-text')!
    const infoSection = document.querySelector<HTMLElement>('.info')!

    if (image && infoSection) {
        const section = infoSection as HTMLElement

        function updateImage() {
            const rect = section.getBoundingClientRect()
            const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)))

            let scale: number

            if (progress <= 0.5) {
                scale = 0.9 + progress * 0.6
            } else {
                scale = 1.2 - (progress - 0.5)
            }

            const fadeStart = 0.65
            const opacity = progress < fadeStart
                ? Math.min(1, progress / 0.2)
                : Math.max(0, 1 - (progress - fadeStart) / (1 - fadeStart))

            const translateY = progress * window.innerHeight * 0.35

            image.style.transform = `translateY(${translateY}px) scale(${scale})`
            image.style.opacity = opacity.toString()
            image.style.visibility = opacity > 0 ? 'visible' : 'hidden'

            textElement.style.transform = `translateY(${translateY}px) scale(${scale})`
            textElement.style.opacity = opacity.toString()
            textElement.style.visibility = opacity > 0 ? 'visible' : 'hidden'
        }

        updateImage()
        window.addEventListener('scroll', updateImage)
        window.addEventListener('resize', updateImage)
    }
</script>