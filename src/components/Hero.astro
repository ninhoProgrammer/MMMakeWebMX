---
import astroImage from "../images/astro.webp";
import makewebMWImage from "../images/MakeWeb_MW.svg";
---

<section class="hero h-screen w-full flex md:grid-cols-2 grid-rows-2 md:grid-rows-none items-center md:items-start justify-center text-center md:text-start space-x-0 md:space-x-8 md:gap-8 md:overflow-hidden md:p-24 xl:p-36">
    <div class="flex grow flex-col w-1/2">
        <h1 class="text-(--color-accent) gradient-overlay text-2xl md:text-5xl xl:text-8xl">Deja que tu marca llegue al <span class="underline">espacio</span></h1>
        <img src={makewebMWImage.src} alt="Astro" class="bg-(--color-background) mt-2 md:mt-4 h-80 md:h-11/12 max-w-xl" />
    </div>
    <div class="flex items-center justify-center md:justify-end">
        <img src={astroImage.src} alt="MakeWeb MW" class="hero-logo h-96 w-80 xl:w-96 md:h-11/12 xl:h-screen max-w-xl" />
    </div>
</section>



