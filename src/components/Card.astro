---
interface Props {
	title: string;
	img: string;
	href: string;
}

const { href, title, img } = Astro.props;
---

<article class="snap-start relative flex flex-col text-(--color-background) max-w-76 gap-2 md:gap-4 px-3 py-3 bg-(--color-primary) backdrop-blur-md rounded-lg bg-linear-to-b from-white/60 to-white/0">

</article>