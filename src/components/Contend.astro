---
import astroHandup from "../images/astro-hand-up.webp";
import astroFrontComplete from "../images/astro-front-complete.webp";
---

<section id="info" class="flex flex-col h-auto px-24 xl:px-36 text-(--color-accent) ">
    <div class="content-block-one sticky top-0 flex flex-col-reverse md:flex-row items-center py-12 space-x-0 md:space-x-4 space-y-4 md:space-y-0 z-20">
        <div class="flex h-auto md:w-1/2 md:grow justify-center order-2 md:order-1 mb-8">
            <img 
                src={astroFrontComplete.src} 
                alt=""
                class="w-full h-auto md:h-100 object-contain rounded-xl"
            />
        </div>
        <div class="flex md:w-1/2 flex-col md:grow order-2 md:order-1 text-center md:text-left">
            <p class="text-xs text-(--color-primary) md:text-sm xl:text-base 2xl:text-lg font-light tracking-[0.5em]">
                ¬Imaginativos 
            </p>
            <h1 class="text-xl lg:text-3xl xl:text-6xl z-1 font-bold underline decoration-(--color-accent) decoration-2 underline-offset-4 mb-2 md:mb-4">
                Llevamos la imaginacion al siguiente nivel.
            </h1>

            <p class="flex text-xs md:text-sm md:leading-relaxed">
                Creemos que la imaginación es la clave para crear soluciones innovadoras y efectivas. Nos esforzamos por pensar fuera de lo convencional y ofrecer ideas 
                frescas que ayuden a nuestros clientes a destacar en su industria.
            </p>
        </div>
    </div>

    <div class="content-block-two sticky top-0 flex flex-col-reverse md:flex-row items-center pt-10 xl:pt-16 space-x-0 md:space-x-4 space-y-4 md:space-y-0 z-20">
        <div class="flex md:w-1/2 flex-col md:grow  order-2 md:order-1 text-center md:text-left">
            <p class="text-xs text-(--color-primary) md:text-sm xl:text-base 2xl:text-lg font-light tracking-[0.5em]">
                ¬Creativos 
            </p>
            <h1 class="text-xl lg:text-3xl xl:text-6xl z-1 font-bold underline decoration-(--color-accent) decoration-2 underline-offset-4 mb-2 md:mb-4">
                Nos apasiona la creatividad y la innovación.
            </h1>
            
            <p class="flex text-xs md:text-sm md:leading-relaxed">
                Nos esforzamos por ofrecer soluciones únicas y personalizadas que ayuden a nuestros clientes a destacar en un mercado cada vez más competitivo y cambiante. Creemos que la creatividad es la clave para lograr resultados excepcionales y duraderos.
            </p>
        </div>

        <div class="flex h-auto md:w-1/2 md:grow justify-center order-1 md:order-2 mb-8">
            <img 
                src={astroHandup.src} 
                alt=""
                class="w-full h-full md:h-100 object-contain rounded-xl"
            />
        </div>

    </div>

</section>

<style>
    .content-block-one {
        transition: opacity 500ms ease-out;
    }

    @media (prefers-reduced-motion: reduce) {
        .content-block-one {
            transition: none;
        }
    }
</style>

<script>
    const firstBlock = document.querySelector<HTMLElement>('.content-block-one')
    const secondBlock = document.querySelector<HTMLElement>('.content-block-two')

    if (firstBlock && secondBlock) {
        const fadeDistance = 240
        let frame = 0

        const updateFirstBlock = () => {
            frame = 0
            const secondBlockTop = secondBlock.getBoundingClientRect().top
            const opacity = Math.min(1, Math.max(0, secondBlockTop / fadeDistance))

            firstBlock.style.opacity = opacity.toString()
        }

        window.addEventListener('scroll', () => {
            if (!frame) frame = requestAnimationFrame(updateFirstBlock)
        }, { passive: true })
        window.addEventListener('resize', updateFirstBlock)
        updateFirstBlock()
    }
</script>
