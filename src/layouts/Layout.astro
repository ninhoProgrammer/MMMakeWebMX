---
import Header from '../components/Header.astro';
import Loading from '../components/Loading.astro';
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>MM Make web</title>
	</head>
    <body class="booting bg-(--color-background) bg-fixed bg-cover" aria-busy="true">
        <Loading />
		<Header />
		<slot />
	</body>
</html>


<style is:global>
	.hero-copy {
        animation: hero-copy-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-word {
        display: inline-block;
        animation: word-in 700ms 450ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-art {
        animation: hero-art-in 1100ms 150ms cubic-bezier(0.22, 1, 0.36, 1) both,
            hero-art-float 5s 1.3s ease-in-out infinite;
    }

    .hero-logo {
        animation: hero-logo-in 1100ms 150ms cubic-bezier(0.22, 1, 0.36, 1) both,
            hero-logo-float 5s 1.3s ease-in-out infinite;
    }

	.gradient-overlay {
        background: linear-gradient(
            55deg,
            #f7333f,
			#f7333fc3,
            #f4f6f8,  
            #102542c3,
            #102542

        );
        -webkit-background-clip: text;
        background-size: 300% 300%;
        background-clip: text;
        color : transparent;
        text-transform: uppercase;
        animation: gradient 5s ease infinite;
    }
  
    @keyframes gradient {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    @keyframes hero-copy-in {
        from {
            opacity: 0;
            transform: translateY(2rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes word-in {
        from {
            opacity: 0;
            transform: translateY(0.8rem) rotate(-4deg);
        }
        to {
            opacity: 1;
            transform: translateY(0) rotate(0);
        }
    }

    @keyframes hero-art-in {
        from {
            opacity: 0;
            transform: translate(2rem, 1rem) scale(0.9) rotate(4deg);
        }
        to {
            opacity: 1;
            transform: translate(0) scale(1) rotate(0);
        }
    }

    @keyframes hero-art-float {
        0%,
        100% {
            transform: translateY(0) rotate(0);
        }
        50% {
            transform: translateY(-0.75rem) rotate(-2deg);
        }
    }

    @keyframes hero-logo-in {
        from {
            opacity: 0;
            transform: translate(-2rem, -1rem) scale(-0.9) rotate(-4deg);
        }
        to {
            opacity: 1;
            transform: translate(0) scale(1) rotate(0);
        }
    }

    @keyframes hero-logo-float {
        0%,
        100% {
            transform: translateY(0) rotate(0);
        }
        50% {
            transform: translateY(0.75rem) rotate(2deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .loading-bar > div {
            animation: none;
        }

        .loading-logo,
        .loading-status,
        .loading-bar,
        body > header,
        body > main {
            transition: none;
        }

        .hero-copy,
        .hero-word,
        .hero-logo,
        .hero-art {
            animation: none;
        }
    }

    .loading-bar > div {
        animation: loading-bar 1.1s ease-in-out infinite;
    }

    #loading-screen.is-loaded {
        opacity: 0;
        pointer-events: none;
    }

    .loading-logo,
    .loading-status,
    .loading-bar {
        transition: opacity 700ms ease, transform 700ms ease;
    }

    #loading-screen.is-loaded .loading-logo {
        opacity: 0;
        transform: scale(1.08);
    }

    #loading-screen.is-loaded .loading-status,
    #loading-screen.is-loaded .loading-bar {
        opacity: 0;
        transform: translateY(0.5rem);
    }

    body.booting > header,
    body.booting > main {
        opacity: 0;
        transform: scale(0.98) translateY(0.75rem);
    }

    body > header,
    body > main {
        transition: opacity 900ms ease 250ms, transform 900ms ease 250ms;
    }

    body.is-booted > header,
    body.is-booted > main {
        opacity: 1;
        transform: none;
    }

    @keyframes loading-bar {
        0% {
            transform: translateX(-100%);
        }
        100% {
            transform: translateX(200%);
        }
    }
</style>

<script>
    window.addEventListener('load', () => {
        const loadingScreen = document.getElementById('loading-screen');

        if (!loadingScreen) return;

        window.setTimeout(() => {
            loadingScreen.classList.add('is-loaded');
            document.body.classList.remove('booting');
            document.body.classList.add('is-booted');
            document.body.removeAttribute('aria-busy');
            loadingScreen.addEventListener('transitionend', () => loadingScreen.remove(), { once: true });
        }, 5000);
    });
</script>