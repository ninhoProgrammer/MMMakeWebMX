---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Helmet from '../components/Helmet.astro';
import Contend from '../components/Contend.astro';
import Speciality from '../components/Speciality.astro';
import Banner from '../components/Banner.astro';
import Findus from '../components/FindUs.astro';
import Rocket from '../components/Rocket.astro';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<main class="relod">
        <Hero />
        <About />
        <Helmet />
        <Contend />
        <Speciality />
        <Banner />
        <Findus />
        <Rocket />
	</main>
</Layout>


<style>
    .about {
        --scroll-intensity: 0;
    }

    .about-fade {
        position: absolute;
        z-index: 1;
        width: 100%;
        height: 30%;
        pointer-events: none;
        opacity: calc(0.2 + var(--scroll-intensity) * 1);
        
        transition: opacity 180ms ease-out;
    }

    .about-fade-top {
        top: -7%;
        background: linear-gradient(to bottom, var(--color-background) 50%, transparent);
    }

    .about-fade-bottom {
        bottom: -7%;
        background: linear-gradient(to top, var(--color-background) 50%, transparent);
    }

    .about h2,
    .about p {
        position: relative;
        z-index: 2;
    }

    @media (prefers-reduced-motion: reduce) {
        .about-fade {
            transition: none;
        }
    }
</style>

<script>
    const aboutSection = document.querySelector<HTMLElement>(".about");

    if (aboutSection && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let frame = 0;

        const updateFade = () => {
            frame = 0;
            const { top, height } = aboutSection.getBoundingClientRect();
            const progress = Math.min(1, Math.max(0, (window.innerHeight - top) / (window.innerHeight + height)));
            aboutSection.style.setProperty("--scroll-intensity", progress.toFixed(4));
        };

        window.addEventListener("scroll", () => {
            if (!frame) frame = requestAnimationFrame(updateFade);
        }, { passive: true });
        updateFade();
    }
</script>